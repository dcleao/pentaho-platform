<?xml version="1.0" encoding="UTF-8"?>
<Context path="/pentaho" docbase="webapps/pentaho/">
	<Resource name="jdbc/Hibernate" auth="Container" type="javax.sql.DataSource"
		factory="org.pentaho.di.core.database.util.DecryptingDataSourceFactory" maxActive="20" minIdle="0" maxIdle="5" initialSize="0"
		maxWait="10000" username="hibuser" password="password"
		driverClassName="org.h2.Driver" url="jdbc:h2:../../pentaho-solutions/system/hibernate/hibernate"
		validationQuery="select count(*) from INFORMATION_SCHEMA.USERS" />
		
	<Resource name="jdbc/Quartz" auth="Container" type="javax.sql.DataSource"
		factory="org.pentaho.di.core.database.util.DecryptingDataSourceFactory" maxActive="20" minIdle="0" maxIdle="5" initialSize="0"
		maxWait="10000" username="sa" password="" testOnBorrow="true"
		driverClassName="org.h2.Driver" url="jdbc:h2:../../pentaho-solutions/quartz/quartz"
		validationQuery="select count(*) from INFORMATION_SCHEMA.USERS"/>

	<Resource name="jdbc/jackrabbit" auth="Container" type="javax.sql.DataSource"
		factory="org.pentaho.di.core.database.util.DecryptingDataSourceFactory" maxActive="20" minIdle="0"
		maxIdle="5" initialSize="0"
		maxWait="10000" username="jcr_user" password="password"
		driverClassName="org.h2.Driver" url="jdbc:h2:../../pentaho-solutions/jackrabbit/jackrabbit"
		validationQuery="select 1"/>

	<!--
        To enable Cross-Origin/Embedding use, set `sameSiteCookies` to `None`.
        To disable, use `Strict`.

        For more information regarding the configuration of the Pentaho Server for Cross-Origin/Embedding operation,
        see the CORS section of `pentaho-solutions/system/system.properties`.
      -->
	<CookieProcessor sameSiteCookies="Strict"
									 className="org.apache.tomcat.util.http.LegacyCookieProcessor" />

</Context>
